-- A lexer for a small calculator, written by `@derive(Lexer)`.
--
-- Everything below the declaration -- the automaton, the scanner -- is written
-- while this package is compiled. Run it with `meadow run` from this
-- directory.

mod Bare

use Scythe (lexer!, token, start, stop, errorAt)
use Std.Collections.Vector as V
use Std.Maybe as M
use Std.Stream as Stream

-- Whitespace and comments are matched like any token; `@skip` leaves them out
-- of what is lexed. Without it they are tokens too, which is what a lossless
-- syntax tree is built from.
@derive(Lexer)
data Token
  = @regex("[ \t\r\n]+") @skip Whitespace
  | @regex("--[^\n]*") @skip Comment
  | @token("+") Plus
  | @token("-") Minus
  | @token("*") Star
  | @token("/") Slash
  | @token("=") Equals
  | @token("(") LParen
  | @token(")") RParen
  | @token("let") Let
  | @regex("[0-9]+(\\.[0-9]+)?") Number String
  | @regex("[a-zA-Z_][a-zA-Z0-9_]*") Ident String
  | @token("\u{221e}") Infinity

-- Each token is printed as it is read: `lexToken` is a stream.
fun main () =
  let input = "let rate = 2.5 * (x + 40) -- how much\n" in
  Stream.forEach
    (\r ->
      match r with
      | Ok t -> println (show (token t))
      | Err e -> println "stopped at byte ${show (errorAt e)}")
    (lexToken input)

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)

-- What a stream of tokens yields, without where each was.
fun streamed producer =
  V.map
    (\r ->
      match r with
      | Ok l -> Ok (token l)
      | Err e -> Err (errorAt e))
    (Stream.toVec producer)

@test fun theTokensComeAsAStreamAndThenWhereTheyStopped () =
  let a =
    assertEq
      (streamed (lexToken "x + 1"))
      [Ok (Token.Ident "x"), Ok Token.Plus, Ok (Token.Number "1")]
      "each token in turn"
  in assertEq
       (streamed (lexToken "x ? 1"))
       [Ok (Token.Ident "x"), Err 2]
       "where it stopped, and nothing after"

-- A consumer that stops asking stops the lexer: the `?` is never read.
@test fun aStreamIsReadOnlyAsFarAsItIsAsked () =
  assertEq
    (V.map
       (\r -> match r with | Ok l -> Just (token l) | Err _ -> None)
       (Stream.take 2 (lexToken "1 2 ?")))
    [Just (Token.Number "1"), Just (Token.Number "2")]
    "two tokens, and no error"

-- The stream and the tokens all at once are the same tokens.
@test fun theStreamIsWhatIsLexedAllAtOnce () =
  let input = "let rate = 2.5 * (x + 40) -- how much\n" in
  assertEq
    (V.map
       (\r ->
         match r with
         | Ok l -> (token l, start l, stop l)
         | Err _ -> (Token.Minus, 0, 0))
       (Stream.toVec (lexToken input)))
    (match lexTokenAll input with
     | Ok ts -> V.map (\l -> (token l, start l, stop l)) ts
     | Err _ -> [])
    "the same, in the same places"

-- `nextToken` reads one token from wherever it is asked to, past any skipped,
-- as logos's `Lexer` does after a `bump`.
@test fun theNextTokenIsReadFromAnyOffset () =
  let input = "let x = 4 -- four\n  + y" in
  let a = assertEq (M.map token (unwrap (nextToken input 0))) (Just Token.Let) "the first" in
  let b =
    assertEq
      (M.map (\l -> (token l, start l, stop l)) (unwrap (nextToken input 8)))
      (Just (Token.Number "4", 8, 9))
      "from the middle"
  in
  let c =
    assertEq
      (M.map token (unwrap (nextToken input 9)))
      (Just Token.Plus)
      "past a comment and a line"
  in assertEq (M.map token (unwrap (nextToken input 23))) None "nothing at the end"

fun unwrap r = match r with | Ok x -> x | Err _ -> None

-- `reachToken` is how far the machine reads: the longest match, or where it
-- gave up when nothing matches, as logos spans the error it makes.
@test fun theMachineReachesTheEndOfTheLongestMatch () =
  let a = assertEq (reachToken "letter = 1" 0) 6 "a name, not `let`" in
  let b = assertEq (reachToken "2.5x" 0) 3 "a number with its fraction" in
  let c = assertEq (reachToken "2.x" 0) 1 "the fraction it could not finish is given back" in
  assertEq (reachToken "?" 0) 0 "nothing at all"

-- `@token` with a character of several bytes matches that character.
@test fun aTokenOfAWideCharacterIsRead () =
  assertEq
    (match lexTokenAll "1 \u{221e}" with
     | Ok ts -> V.map token ts
     | Err _ -> [])
    [Token.Number "1", Token.Infinity]
    "the number, and the infinity sign"
